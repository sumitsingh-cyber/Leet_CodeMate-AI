# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# --- Gemini (get a key at https://aistudio.google.com) ---
GEMINI_API_KEY=
# Pick a model your key can use in Google AI Studio and paste its exact name here.
GEMINI_MODEL=

# --- Server ---
PORT=3000
NODE_ENV=development
# Kill switch: set to false to stop all AI calls immediately.
AI_ENABLED=true
# Dev only: returns canned answers so you can test without a key. Refused in production.
MOCK_AI=false

# --- Security ---
# Random string, 32+ chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
TOKEN_TTL_SECONDS=3600
# Comma-separated extension ID(s) from chrome://extensions. Required in production.
ALLOWED_EXTENSION_IDS=

# --- Limits (UTC day) ---
PER_INSTALL_DAILY_LIMIT=40
PER_IP_DAILY_LIMIT=150
GLOBAL_DAILY_LIMIT=1500
PER_INSTALL_PER_MINUTE=8
SESSIONS_PER_IP_PER_HOUR=30
MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT_MS=90000
VERIFY_RETRY=false
